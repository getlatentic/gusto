#!/usr/bin/env bash
# Brings this host to a commit of gusto's main branch: the newest, or the one named. It builds the commit as the gusto-build user
# with the same script CI uses (bundle.sh), builds the runner image as the gusto user when the commit needs one this host has not
# got, and runs the commit's cloud playbook, which makes the host all of gusto cloud. The timer runs it every five minutes, and it
# does nothing when the host is at the newest commit. A failed build leaves the running release as it was.
set -euo pipefail
state=${GUSTO_UPGRADE_STATE:-/var/lib/gusto-upgrade}
repo=${GUSTO_REPO:-https://github.com/getlatentic/gusto.git}
src=$state/src out=$state/out builder=gusto-build runner=gusto

# The builds run at low priority with a cap on memory, beside the host's other services.
limited() { systemd-run --quiet --wait --collect --pipe -p MemoryMax=3G -p MemorySwapMax=2G -p CPUWeight=20 -p IOWeight=20 "$@"; }
build() {
  limited --uid="$builder" --gid="$builder" -p WorkingDirectory="$src" -E HOME="/home/$builder" \
    -E PATH=/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin "$@"
}
podman_as_runner() { limited runuser -u "$runner" -- env XDG_RUNTIME_DIR="/run/user/$(id -u "$runner")" podman "$@"; }

exec 9> "$state.lock"
flock -n 9 || { echo "gusto-upgrade: another upgrade is running"; exit 0; }
[ -d "$src/.git" ] || runuser -u "$builder" -- git clone --quiet "$repo" "$src"
build git fetch --quiet origin main
commit=${1:-$(build git rev-parse origin/main)}
case "$commit" in *[!0-9a-f]* | "") echo "gusto-upgrade: $commit is not a commit" >&2; exit 2 ;; esac
# GUSTO_UPGRADE_FORCE runs it again at the same commit, after the host's settings or secrets have changed.
[ -n "${GUSTO_UPGRADE_FORCE:-}" ] || [ "$commit" != "$(cat "$state/release" 2>/dev/null || true)" ] || exit 0

echo "gusto-upgrade: building $commit"
build git checkout --quiet --detach --force "$commit"
# What an earlier build left is removed, except the web app's packages, which npm reinstalls only when the lock file changes.
build git clean -fdxq -e web/node_modules
rm -rf "$out" && install -d -o "$builder" -g "$builder" "$out"
build bash deploy/aws/openshell/bundle.sh "$out"
key=$(tar -xzf "$out/bundle.tgz" -O ./image.key)

if ! podman_as_runner image exists "gusto-runner:$key"; then
  echo "gusto-upgrade: building the runner image $key"
  harnesses=$(build bash deploy/aws/openshell/harnesses.sh)
  podman_as_runner build --quiet --build-arg "HARNESSES=$harnesses" -t "gusto-runner:$key" "$src" >/dev/null
  # The layers of the build that no image uses are removed; gusto-boot removes the images of other keys.
  podman_as_runner image prune --force >/dev/null
fi

bundle=$state/bundle
rm -rf "$bundle" && mkdir -p "$bundle" && tar -xzf "$out/bundle.tgz" -C "$bundle"
ansible-playbook -c local -i 'host,' -e @/etc/gusto/cloud-vars.json -e cloud_bucket= -e cloud_region=us-east-1 \
  -e "cloud_image_key=$key" -e "cloud_release=$commit" -e cloud_role=all -e cloud_live=true \
  -e cloud_baked=false -e cloud_bake=false -e cloud_check_public=false -e cloud_lease_minutes=30 -e cloud_max_hours=24 \
  "$bundle/ansible/cloud.yml"
printf '%s' "$commit" > "$state/release"
echo "gusto-upgrade: this host is at $commit"
