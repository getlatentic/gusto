# Managed by ansible (roles/serve/templates/haas.env.j2).
GUSTO_ADDR=127.0.0.1:{{ backend_port }}
GUSTO_STORE={{ store }}
{% if store == 'mysql' %}
# The database and the Redis index are claimed and not yet read by anything, so
# neither is named here. Writing an unused credential into a file on disk is
# exposure that buys nothing — and a DSN no shell can parse gets printed by the
# first person who sources this file to debug it.
GUSTO_REDIS_URL={{ redis_url }}
{% else %}
GUSTO_SQLITE={{ sqlite_path }}
{% endif %}

# One job at a time is one container. These are what a job may take of a box that
# is also serving other people's sites.
GUSTO_JOB_CONCURRENCY={{ job_concurrency }}
{% if limit_person %}
GUSTO_LIMIT_PERSON={{ limit_person }}
{% endif %}
{% if limit_team %}
GUSTO_LIMIT_TEAM={{ limit_team }}
{% endif %}
GUSTO_JOB_MEMORY={{ job_memory }}
GUSTO_JOB_CPUS={{ job_cpus }}
GUSTO_CONTAINER={{ container_runtime }}
GUSTO_IMAGE={{ runner_image }}
GUSTO_JOBS={{ app_root }}/var/jobs
GUSTO_SESSIONS={{ app_root }}/var/sessions
GUSTO_HARNESSES={{ harnesses_dir }}
GUSTO_MODELS={{ models }}
GUSTO_MCP={{ app_root }}/var/mcp
# Every record is signed on this box, and named by the keyring's name for the key.
GUSTO_SIGNING_KEY={{ app_root }}/var/signing/{{ signer_name }}.key
{% if github_app_id %}
# A GitHub App reaches the repositories jobs name, with a token for one
# repository that is revoked when its work is done. docs/REPOS.md.
GUSTO_GITHUB_APP_ID={{ github_app_id }}
GUSTO_GITHUB_APP_KEY={{ app_root }}/var/github/app.pem
{% if github_url %}
GUSTO_GITHUB_URL={{ github_url }}
GUSTO_GITHUB_API={{ github_api }}
{% endif %}
{% endif %}
GUSTO_KEYRING={{ app_root }}/var/keyring
GUSTO_SETUPS={{ app_root }}/var/setups
GUSTO_INTEGRATIONS={{ app_root }}/var/integrations
GUSTO_PRESETS={{ app_root }}/var/presets
GUSTO_COMPARISONS={{ app_root }}/var/comparisons
GUSTO_CHANGES={{ app_root }}/var/changes/changes.jsonl
GUSTO_RETENTION={{ app_root }}/var/retention
GUSTO_DEPLOY_RESULT={{ app_root }}/var/deploy.json
{% if migrate_irreversible | default(false) %}
GUSTO_MIGRATE_IRREVERSIBLE=1
{% endif %}
{% if api_tokens %}
# The API takes these tokens and not the shared password. docs/TOKENS.md.
GUSTO_API_TOKENS={{ app_root }}/var/tokens/tokens.json
{% endif %}
# What the box matrix measured each harness and model doing on the simplest
# job, for the catalog to say. Until a matrix has run here the file is not
# there, and the catalog says nothing about models.
GUSTO_MATRIX={{ app_root }}/var/matrix/box-matrix/table.json
{% if credentials %}
# One file a credential, written by the playbook and readable by this user
# alone. No key is in this file.
GUSTO_CREDENTIALS={{ app_root }}/var/credentials
{% if spend_policy is defined %}
GUSTO_SPEND_POLICY={{ app_root }}/var/spend.json
{% endif %}
GUSTO_PROXY_ADDR={{ proxy_addr }}
{% elif model_upstream %}
GUSTO_MODEL_UPSTREAM={{ model_upstream }}
GUSTO_MODEL_KEY={{ model_key | default('') }}
GUSTO_MODEL_NAME={{ model_name }}
GUSTO_PROXY_ADDR={{ proxy_addr }}
{% endif %}
{% if model_url %}
GUSTO_MODEL_URL={{ model_url }}
{% endif %}
GUSTO_SIGNER={{ server_name }}
# The shared credential, from the vault and never from a default. It stays
# beside an identity provider rather than being replaced by one: a provider
# nobody here runs must not be able to lock the owner out of a running job.
GUSTO_PASSWORD={{ gusto_password }}
{% if oidc_issuer %}

# Sign-in by an identity provider this deployment points at. The provider
# settles who somebody is; GUSTO_ALLOWED settles who may spend the credential.
GUSTO_OIDC_ISSUER={{ oidc_issuer }}
GUSTO_OIDC_CLIENT_ID={{ oidc_client_id }}
GUSTO_OIDC_CLIENT_SECRET={{ oidc_client_secret }}
GUSTO_OIDC_REDIRECT={{ oidc_redirect }}
GUSTO_ALLOWED={{ oidc_allowed }}
# Each person sees their own agents, jobs, comparisons and spend. These
# addresses see everybody's and change what agents are given, as the shared
# password does.
GUSTO_ADMINS={{ gusto_admins }}
{% if oidc_runner_groups or oidc_admin_groups %}
# The provider's groups that grant each role. Somebody in neither is refused.
GUSTO_RUNNER_GROUPS={{ oidc_runner_groups }}
GUSTO_ADMIN_GROUPS={{ oidc_admin_groups }}
{% if oidc_groups_claim %}GUSTO_OIDC_GROUPS_CLAIM={{ oidc_groups_claim }}
{% endif %}{% if oidc_scopes %}GUSTO_OIDC_SCOPES={{ oidc_scopes }}
{% endif %}{% endif %}{% endif %}
