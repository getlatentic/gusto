# Managed by ansible (roles/serve/templates/haas.env.j2).
HAAS_ADDR=127.0.0.1:{{ backend_port }}
HAAS_STORE={{ store }}
{% if store == 'mysql' %}
# The database and the Redis index are claimed and not yet read by anything, so
# neither is named here. Writing an unused credential into a file on disk is
# exposure that buys nothing — and a DSN no shell can parse gets printed by the
# first person who sources this file to debug it.
HAAS_REDIS_URL={{ redis_url }}
{% else %}
HAAS_SQLITE={{ sqlite_path }}
{% endif %}

# One job at a time is one container. These are what a job may take of a box that
# is also serving other people's sites.
HAAS_JOB_CONCURRENCY={{ job_concurrency }}
HAAS_JOB_MEMORY={{ job_memory }}
HAAS_JOB_CPUS={{ job_cpus }}
HAAS_CONTAINER={{ container_runtime }}
HAAS_IMAGE={{ runner_image }}
HAAS_JOBS={{ app_root }}/var/jobs
HAAS_SESSIONS={{ app_root }}/var/sessions
HAAS_HARNESSES={{ harnesses_dir }}
{% if model_upstream %}
HAAS_MODEL_UPSTREAM={{ model_upstream }}
HAAS_MODEL_KEY={{ model_key | default('') }}
HAAS_MODEL_NAME={{ model_name }}
HAAS_PROXY_ADDR={{ proxy_addr }}
{% endif %}
{% if model_url %}
HAAS_MODEL_URL={{ model_url }}
{% endif %}
HAAS_SIGNER={{ server_name }}
# The shared credential that stands in for sign-in until there is an identity
# provider. From the vault, never from a default.
HAAS_PASSWORD={{ haas_password }}
