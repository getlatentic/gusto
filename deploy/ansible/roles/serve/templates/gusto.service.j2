[Unit]
Description=gusto — tasks, their records, and the pages in front of them
After=network.target{% if store == 'mysql' %} mysql.service redis-server.service{% endif %}

{% if store == 'mysql' %}
Wants=mysql.service redis-server.service
{% endif %}

[Service]
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_root }}
EnvironmentFile={{ app_root }}/var/gusto.env
# Rootless podman keeps its image store under this home, and needs a user
# runtime directory to talk to conmon.
Environment=HOME={{ app_root }}
Environment=XDG_RUNTIME_DIR=/run/user/{{ app_uid }}
ExecStart={{ live_bin }} serve
Restart=always
RestartSec=3
# A container holding a job is a child. On stop the service is signalled and gets
# time to end its jobs and write their evidence before anything is killed.
KillMode=mixed
TimeoutStopSec=60
# It runs other people's code, on a box that serves other people's sites.
#
# ProtectHome is deliberately absent. It hides /run/user, which is where rootless
# podman keeps its runtime directory, and podman then cannot start a container at
# all: "cannot evaluate symlinks on DB tmp dir path /run/user/997/libpod/tmp:
# permission denied". ReadWritePaths does not give it back. What is lost is
# defense in depth over file permissions this unprivileged user is bound by
# anyway: it cannot read /root or another user's home either way.
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths={{ app_root }}
PrivateTmp=true

[Install]
WantedBy=multi-user.target
