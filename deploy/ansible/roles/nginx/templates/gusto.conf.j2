# Managed by ansible (roles/nginx/templates/gusto.conf.j2).
# One name-based vhost for {{ server_name }}, coexisting with the other sites on
# this nginx. The binary serves its own pages as well as its API, so everything
# is proxied at the root rather than under /api/.
server {
    listen {% if tls_active | bool %}{{ api_public_port }} ssl{% elif enable_tls | bool %}80{% else %}{{ api_public_port }}{% endif %};

    server_name {{ server_name }};
{% if tls_active | bool %}
    ssl_certificate /etc/letsencrypt/live/{{ server_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ server_name }}/privkey.pem;
{% endif %}
{% if enable_tls | bool %}
    location /.well-known/acme-challenge/ {
        root {{ acme_webroot }};
    }
{% endif %}

    # When the server is not answering, as it is for a second while a deploy restarts it, nginx cannot ask it for a page, so it gives
    # its own: one that tries again by itself. It keeps the status, so that whatever watches the site still sees the failure.
    error_page 502 503 504 /__gusto_down.html;
    location = /__gusto_down.html {
        internal;
        alias {{ gusto_errors_dir }}/down.html;
        add_header Cache-Control "no-store" always;
    }

    # A job's output is a stream that stays open for as long as the job runs, so
    # nginx must not buffer it and must not time it out at the default 60s.
    location /watch/ {
        proxy_pass http://127.0.0.1:{{ backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 3600s;
    }

    # A room's page keeps one WebSocket open to the server, which pings it every 30 s. The upgrade must pass, nothing may be
    # buffered, and a quiet connection must not be cut at the 60 s nginx would give a proxied one. The Origin the browser sent is
    # checked against the Host, so Host is passed as it came.
    location = /live {
        proxy_pass http://127.0.0.1:{{ backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ backend_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
{% if tls_active | bool %}

server {
    listen 80;
    server_name {{ server_name }};
    location /.well-known/acme-challenge/ {
        root {{ acme_webroot }};
    }
    location / {
        return 301 https://$host$request_uri;
    }
}
{% endif %}
