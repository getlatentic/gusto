# TLS for the name and every name under it, passed to the front door on this host.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# A name that is not ours gets no answer.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    server_name {{ demo_name }} *.{{ demo_name }};

    ssl_certificate     /etc/letsencrypt/live/{{ demo_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ demo_name }}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:8050;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The address nginx saw, and not one the visitor wrote.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Pages that stream a running job are held open.
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
