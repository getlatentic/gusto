# The front door's settings.
HAAS_CLOUD_ROOT={{ demo_state }}/cloud
HAAS_CLOUD_ADDR=127.0.0.1:8050
HAAS_CLOUD_URL=https://{{ demo_name }}
HAAS_CLOUD_DOMAIN={{ demo_name }}
HAAS_CLOUD_ORG_ENV=/etc/haas/org.env
HAAS_CLOUD_PORT_FROM=9100
HAAS_CLOUD_TRUST_PROXY=1
HAAS_CLOUD_FREE_MAIL={{ demo_free_mail }}
HAAS_CLOUD_MAIL={{ demo_mail }}
{% if not demo_live | bool %}
HAAS_CLOUD_LEASE_FILE={{ demo_lib }}/lease.json
HAAS_CLOUD_LEASE_STEP_MINUTES={{ demo_lease_minutes }}
{% endif %}
{% if demo_role == 'orchestrator' %}
# Organisations are placed on cells, which register in the directory on the shared file system.
HAAS_CLOUD_CELLS_DIR={{ demo_state }}/cells
HAAS_CLOUD_CELL_SECRET_FILE=/run/haas/cell-secret
HAAS_CLOUD_CELL_GONE_MINUTES={{ demo_cell_gone_minutes }}
{% endif %}
{% if demo_visitor_minutes | int > 0 %}
# A visitor starts a demo without signing up, and it is deleted when its time is up.
HAAS_CLOUD_DEMO_MINUTES={{ demo_visitor_minutes }}
HAAS_CLOUD_DEMO_MAX={{ demo_visitor_max }}
HAAS_CLOUD_BOOK_URL={{ demo_book_url }}
HAAS_CLOUD_DEMO_VIDEO={{ demo_video_url }}
{% endif %}
{% if demo_live | bool %}
# Hosts for cells are started when organisations wait for room, and stopped when a cell has had nothing on it.
HAAS_CLOUD_CELL_LAUNCH=ec2
HAAS_CLOUD_CELL_TEMPLATE={{ demo_cell_template }}
HAAS_CLOUD_CELL_PROJECT={{ demo_project }}
HAAS_CLOUD_CELL_USERDATA={{ demo_cell_userdata }}
HAAS_CLOUD_CELL_SETTINGS=RELEASE={{ demo_release }},BUCKET={{ demo_bucket }},REGION={{ demo_region }},LEASE_MINUTES=30,MAX_HOURS={{ demo_cell_max_hours }},ROLE=cell,RUN={{ demo_run }},EFS={{ demo_efs.split('.')[0] }},LIVE=off
HAAS_CLOUD_CELL_MAX={{ demo_cell_max }}
HAAS_CLOUD_CELL_IDLE_MINUTES={{ demo_cell_idle_minutes }}
{% endif %}
