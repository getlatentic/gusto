# The front door's settings.
GUSTO_CLOUD_ROOT={{ demo_state }}/cloud
GUSTO_CLOUD_ADDR=127.0.0.1:8050
# The accounts and each organization's task index live on this host's own disk, because a write-ahead log does not belong on a shared file system.
GUSTO_DATABASE_URL=sqlite://{{ demo_lib }}/cloud.db
GUSTO_CLOUD_INDEX_DIR={{ demo_lib }}/index
GUSTO_CLOUD_URL=https://{{ demo_name }}
GUSTO_CLOUD_DOMAIN={{ demo_name }}
GUSTO_CLOUD_ORG_ENV=/etc/gusto/org.env
GUSTO_CLOUD_PORT_FROM=9100
GUSTO_CLOUD_TRUST_PROXY=1
GUSTO_CLOUD_FREE_MAIL={{ demo_free_mail }}
GUSTO_CLOUD_MAIL={{ demo_mail }}
{% if not demo_live | bool %}
GUSTO_CLOUD_LEASE_FILE={{ demo_lib }}/lease.json
GUSTO_CLOUD_LEASE_STEP_MINUTES={{ demo_lease_minutes }}
{% endif %}
{% if demo_role == 'orchestrator' %}
# Organizations are placed on cells, which register in the directory on the shared file system.
GUSTO_CLOUD_CELLS_DIR={{ demo_state }}/cells
GUSTO_CLOUD_CELL_SECRET_FILE=/run/gusto/cell-secret
GUSTO_CLOUD_CELL_GONE_MINUTES={{ demo_cell_gone_minutes }}
{% endif %}
{% if demo_visitor_minutes | int > 0 %}
# A visitor starts a demo without signing up, and it is deleted when its time is up.
GUSTO_CLOUD_DEMO_MINUTES={{ demo_visitor_minutes }}
GUSTO_CLOUD_DEMO_MAX={{ demo_visitor_max }}
GUSTO_CLOUD_BOOK_URL={{ demo_book_url }}
GUSTO_CLOUD_TURNSTILE_SITE={{ demo_turnstile_site }}
GUSTO_CLOUD_DEMO_VIDEO={{ demo_video_url }}
GUSTO_CLOUD_DEMO_NOTIFY={{ demo_notify }}
{% endif %}
{% if demo_live | bool %}
# Hosts for cells are started when organizations wait for room, and stopped when a cell has had nothing on it.
GUSTO_CLOUD_CELL_LAUNCH=ec2
GUSTO_CLOUD_CELL_TEMPLATE={{ demo_cell_template }}
GUSTO_CLOUD_CELL_PROJECT={{ demo_project }}
GUSTO_CLOUD_CELL_USERDATA={{ demo_cell_userdata }}
GUSTO_CLOUD_CELL_SETTINGS=RELEASE={{ demo_release }},BUCKET={{ demo_bucket }},REGION={{ demo_region }},LEASE_MINUTES=30,MAX_HOURS={{ demo_cell_max_hours }},ROLE=cell,RUN={{ demo_run }},EFS={{ demo_efs.split('.')[0] }},LIVE=off
GUSTO_CLOUD_CELL_MAX={{ demo_cell_max }}
GUSTO_CLOUD_CELL_IDLE_MINUTES={{ demo_cell_idle_minutes }}
GUSTO_CLOUD_CELL_PREWARMS={{ demo_cell_prewarms }}
{% endif %}
