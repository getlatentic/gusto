[Unit]
Description=gusto operator: the page the operator manages the public cloud from, on this machine's loopback only
After=gusto-cloud.service
RequiresMountsFor={{ demo_state }}

[Service]
User={{ demo_user }}
WorkingDirectory={{ demo_state }}
# The AWS command is a snap, which the default path does not have.
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/snap/bin
Environment=HOME=/home/{{ demo_user }}
EnvironmentFile=/etc/gusto/cloud.env
Environment=GUSTO_OWNER_ADDR=127.0.0.1:8090
ExecStart=/usr/local/bin/gusto operator
Restart=always

[Install]
WantedBy=multi-user.target
