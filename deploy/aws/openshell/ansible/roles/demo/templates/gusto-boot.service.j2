[Unit]
Description=Certificate, image, credentials and DNS for a gusto demo host
After=network-online.target{{ (' docker.service' if demo_sandbox == 'container' else ' openshell-gateway.service') if demo_role != 'orchestrator' else '' }}
Wants=network-online.target
Before=nginx.service gusto-cloud.service gusto-cell.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/gusto-boot
{% if demo_role != 'cell' and not demo_live | bool %}
ExecStop=/usr/local/bin/gusto-dns -zone {{ demo_zone }} -name {{ demo_name }} -remove -token-file /run/gusto/secrets/cf-dns-token
{% endif %}
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
