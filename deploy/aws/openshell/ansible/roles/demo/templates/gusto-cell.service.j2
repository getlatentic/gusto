[Unit]
Description=gusto host: starts and stops organizations' servers for gusto cloud
After=gusto-boot.service openshell-gateway.service
Requires=gusto-boot.service
RequiresMountsFor={{ demo_state }}

[Service]
User={{ demo_user }}
SupplementaryGroups=kvm
WorkingDirectory={{ demo_lib }}
EnvironmentFile=/etc/gusto/org.env
EnvironmentFile=/etc/gusto/cell.env
EnvironmentFile=/run/gusto/cell.env
# The first question asked of the image waits for the gateway to import it. It is asked here, so the cell registers,
# and is given organizations, once the servers it starts will not wait for that.
ExecStartPre=/usr/local/bin/gusto scan
TimeoutStartSec=900
ExecStart=/usr/local/bin/gusto host
Restart=on-failure
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
