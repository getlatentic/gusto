{# The settings an organization's server runs its agents with, in the sandbox named. #}
{% macro sandbox_env(sandbox) %}
{% if sandbox == 'container' %}
PATH=/usr/local/bin:/usr/sbin:/sbin:/usr/bin:/bin
GUSTO_SANDBOX=container
GUSTO_IMAGE=gusto-runner:{{ demo_image_key }}
GUSTO_IMAGE_SOURCE=s3://{{ demo_bucket }}/image/{{ demo_image_key }}.docker.tar.gz
GUSTO_JOB_MEMORY={{ demo_computer_memory | regex_replace('i$', '') | lower }}
GUSTO_JOB_CPUS={{ demo_computer_cpu }}
{% else %}
PATH={{ openshell_bin }}:/usr/local/bin:/usr/sbin:/sbin:/usr/bin:/bin
XDG_CONFIG_HOME={{ openshell_config }}
XDG_STATE_HOME={{ openshell_state }}
OPENSHELL_LOCAL_TLS_DIR={{ openshell_state }}/openshell/tls
GUSTO_SANDBOX=openshell
GUSTO_OPENSHELL_IMAGE={{ demo_lib }}/runner-all-rootfs.tar.gz
GUSTO_OPENSHELL_GATEWAY={{ openshell_gateway_name }}
GUSTO_OPENSHELL_MEMORY={{ demo_computer_memory }}
GUSTO_OPENSHELL_CPU={{ demo_computer_cpu }}
GUSTO_SPARE_COMPUTER=on
{% endif %}
{% endmacro %}
