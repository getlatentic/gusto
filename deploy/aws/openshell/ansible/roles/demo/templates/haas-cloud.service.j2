[Unit]
Description=haas public cloud: gusto cloud and each organisation's server
After=haas-boot.service{{ ' openshell-gateway.service' if demo_role != 'orchestrator' else '' }}
Requires=haas-boot.service
RequiresMountsFor={{ demo_state }}

[Service]
User={{ demo_user }}
SupplementaryGroups=kvm
WorkingDirectory={{ demo_state }}
# The AWS command is a snap, which the default path does not have.
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/snap/bin
EnvironmentFile=/etc/haas/cloud.env
EnvironmentFile=/run/haas/secrets/mail.env
EnvironmentFile=-/run/haas/secrets/turnstile.env
EnvironmentFile=-/run/haas/secrets/leadhook.env
ExecStart=/usr/local/bin/haas cloud
Restart={{ "always" if demo_live | bool else "on-failure" }}
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
