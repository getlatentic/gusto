# What every organisation's server is started with (HAAS_CLOUD_ORG_ENV).
PATH={{ openshell_bin }}:/usr/local/bin:/usr/sbin:/sbin:/usr/bin:/bin
XDG_CONFIG_HOME={{ openshell_config }}
XDG_STATE_HOME={{ openshell_state }}
OPENSHELL_LOCAL_TLS_DIR={{ openshell_state }}/openshell/tls
HAAS_SANDBOX=openshell
HAAS_OPENSHELL_IMAGE={{ demo_lib }}/runner-all-rootfs.tar.gz
HAAS_OPENSHELL_GATEWAY={{ openshell_gateway_name }}
HAAS_OPENSHELL_MEMORY={{ demo_computer_memory }}
HAAS_OPENSHELL_CPU={{ demo_computer_cpu }}
HAAS_CREDENTIALS=/run/haas/creds
HAAS_MODELS={{ demo_models }}
HAAS_SPEND_POLICY=/etc/haas/spend-policy.json
