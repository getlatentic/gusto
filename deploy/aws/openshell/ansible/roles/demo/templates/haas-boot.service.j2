[Unit]
Description=Certificate, image, credentials and DNS for a haas demo host
After=network-online.target{% if demo_role != 'orchestrator' %} openshell-gateway.service{% endif %}
Wants=network-online.target
Before=nginx.service haas-cloud.service haas-cell.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/haas-boot
{% if demo_role != 'cell' %}ExecStop=/usr/local/bin/haas-dns -zone {{ demo_zone }} -name {{ demo_name }} -remove -token-file /run/haas/secrets/cf-dns-token
{% endif %}TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
