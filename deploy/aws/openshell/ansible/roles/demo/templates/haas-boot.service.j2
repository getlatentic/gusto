[Unit]
Description=Certificate, image, credentials and DNS for a haas demo host
After=network-online.target openshell-gateway.service
Wants=network-online.target
Before=nginx.service haas-cloud.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/haas-boot
ExecStop=/usr/local/bin/haas-dns -zone {{ demo_zone }} -name {{ demo_name }} -remove -token-file /run/haas/secrets/cf-dns-token
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
