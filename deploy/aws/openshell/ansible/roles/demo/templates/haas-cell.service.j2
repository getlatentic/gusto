[Unit]
Description=haas cell: starts and stops organisations' servers for the front door
After=haas-boot.service openshell-gateway.service
Requires=haas-boot.service
RequiresMountsFor={{ demo_state }}

[Service]
User={{ demo_user }}
SupplementaryGroups=kvm
WorkingDirectory={{ demo_lib }}
EnvironmentFile=/etc/haas/org.env
EnvironmentFile=/etc/haas/cell.env
EnvironmentFile=/run/haas/cell.env
# The first question asked of the image waits for the gateway to import it. It is asked here, so the cell registers,
# and is given organisations, once the servers it starts will not wait for that.
ExecStartPre=/usr/local/bin/haas survey
TimeoutStartSec=900
ExecStart=/usr/local/bin/haas cell
Restart=on-failure
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
