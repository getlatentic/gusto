#!/usr/bin/env bash
# Runs as root every 30 seconds. It powers the host off when its lease has ended, when the
# lease file is not a lease, or when the host has been up as long as any host may be, whatever
# the lease says. An instance launched to terminate on shutdown is removed by that, so
# nothing here has an AWS credential. A host with no lease file yet, and time left, is left
# alone: the start-up script writes it, and a host that never gets one meets the limit.
#
# A cell has no lease of its own. It works for a front door, which says every few seconds that it is
# there, and a cell that has not heard it for BEAT_STALE_SECONDS powers off, once it has been up long
# enough for the front door to have been started (BEAT_GRACE_SECONDS).
#
# GUSTO_LEASE_FILE, GUSTO_BEAT_FILE, GUSTO_NOW and GUSTO_UPTIME move what it reads, and GUSTO_CONF where the
# limit is kept, which is how a test runs it.
set -euo pipefail
# shellcheck disable=SC1090
. "${GUSTO_CONF:-/etc/haas/demo.conf}"
lease=${GUSTO_LEASE_FILE:-/var/lib/haas/lease.json}
beat=${GUSTO_BEAT_FILE:-/var/lib/haas-cloud/cells/orchestrator.beat}
now=${GUSTO_NOW:-$(date +%s)}
uptime=${GUSTO_UPTIME:-$(cut -d. -f1 /proc/uptime)}
stale=${BEAT_STALE_SECONDS:-300}
grace=${BEAT_GRACE_SECONDS:-900}

lease_over() {
  local deadline
  [ -e "$lease" ] || return 1
  if deadline=$(python3 -c 'import json,sys; print(int(json.load(open(sys.argv[1]))["deadline"]))' "$lease" 2>/dev/null); then
    [ "$now" -ge "$deadline" ] && echo "its lease ended"
  else
    echo "its lease file is not a lease"
  fi
}

front_door_gone() {
  local seen
  [ "$uptime" -ge "$grace" ] || return 0
  seen=$(python3 -c 'import os,sys; print(int(os.path.getmtime(sys.argv[1])))' "$beat" 2>/dev/null || echo 0)
  [ $((now - seen)) -lt "$stale" ] || echo "gusto cloud has not been heard from for ${stale} s"
}

why=""
if [ "$uptime" -ge $((MAX_HOURS * 3600)) ]; then
  why="it has been up ${uptime} s, the most any host may be"
elif [ "${ROLE:-all}" = cell ]; then
  why=$(front_door_gone)
else
  why=$(lease_over || true)
fi
if [ -n "$why" ]; then
  echo "haas-lease: $why, so the host is powering off"
  systemctl poweroff
fi
