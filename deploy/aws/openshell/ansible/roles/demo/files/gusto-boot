#!/usr/bin/env bash
# Runs as root when a demo host starts, before nginx, gusto cloud and gusto host. What it does depends on ROLE:
#
#   all           a host that is the front door and runs the organizations' servers too
#   orchestrator  the front door alone: the tokens, the certificate, the lease and the name
#   cell          a host that runs organizations' servers: the runner image, the model credentials,
#                 and who it is to the agent
#
# An orchestrator and a cell both have the secret their requests are signed with. The name is
# pointed at a host last of all, once it can answer.
#
# A certificate is kept in the store and reused until it has under 30 days left, because
# Let's Encrypt allows five certificates a week for one set of names and a host that
# asked for a new one at every start would run out of them.
#
# The paths can be moved with GUSTO_RUN, GUSTO_LE, GUSTO_LIB, GUSTO_LEASE_FILE and GUSTO_CONF, and the owner of the
# files with GUSTO_OWNER (empty leaves them alone), which is how a test runs it.
set -euo pipefail
CONF=${GUSTO_CONF:-/etc/gusto/demo.conf}
run=${GUSTO_RUN:-/run/gusto}
le=${GUSTO_LE:-/etc/letsencrypt}
lib=${GUSTO_LIB:-/var/lib/gusto}
owner=${GUSTO_OWNER-ubuntu}
# shellcheck disable=SC1090
. "$CONF"
role=${ROLE:-all}
# Where the AWS command is on a host is added to the end, so a command that is already found first stays.
export AWS_REGION AWS_DEFAULT_REGION=$AWS_REGION PATH=$PATH:/usr/local/bin:/snap/bin

own() { [ -z "$owner" ] || chown -R "$owner:$owner" "$@"; }
param() { gusto param "$1"; }
metadata() {
  local token
  token=$(curl -fsS -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60')
  curl -fsS -H "X-aws-ec2-metadata-token: $token" "http://169.254.169.254/latest/meta-data/$1"
}

tokens() {
  (
    umask 077
    # Each is read into a variable first: a failure inside an argument does not stop the script.
    dns_token=$(param "$DNS_TOKEN_PARAMETER")
    mail_token=$(param "$MAIL_TOKEN_PARAMETER")
    printf '%s' "$dns_token" > "$run/secrets/cf-dns-token"
    printf 'dns_cloudflare_api_token = %s\n' "$dns_token" > "$run/secrets/certbot-cf.ini"
    printf 'GUSTO_CLOUD_MAIL_TOKEN=%s\n' "$mail_token" > "$run/secrets/mail.env"
  )
}

# The secret of the bot check on the demo form, kept for the front door's own service to read as the environment. A host
# whose parameter is not stored has no bot check, which the front door says, and which a visitor does not see.
turnstile() {
  local secret
  rm -f "$run/secrets/turnstile.env"
  if secret=$(param "$TURNSTILE_PARAMETER" 2>/dev/null) && [ -n "$secret" ]; then
    (umask 077; printf 'GUSTO_CLOUD_TURNSTILE_SECRET=%s\n' "$secret" > "$run/secrets/turnstile.env")
  else
    echo "gusto-boot: no bot check, since $TURNSTILE_PARAMETER is not stored"
  fi
}

# Where a lead is sent when a demo starts and ends, which the front door's own service reads as its environment. A host
# without both parameters sends nowhere, which the front door says, and which a visitor does not see.
lead_hook() {
  local address secret
  rm -f "$run/secrets/leadhook.env"
  if address=$(param "$LEAD_HOOK_URL_PARAMETER" 2>/dev/null) && secret=$(param "$LEAD_HOOK_SECRET_PARAMETER" 2>/dev/null) && [ -n "$address" ] && [ -n "$secret" ]; then
    (umask 077; printf 'GUSTO_CLOUD_LEAD_HOOK_URL=%s\nGUSTO_CLOUD_LEAD_HOOK_SECRET=%s\n' "$address" "$secret" > "$run/secrets/leadhook.env")
  else
    echo "gusto-boot: no lead hook, since $LEAD_HOOK_URL_PARAMETER and $LEAD_HOOK_SECRET_PARAMETER are not both stored"
  fi
}

certificate() {
  local live=$le/live/$NAME fetched kept
  if [ ! -e "$live/fullchain.pem" ]; then
    fetched=$(mktemp)
    if aws s3 cp "s3://$BUCKET/tls/$NAME.tgz" "$fetched" >/dev/null 2>&1; then
      mkdir -p "$le" && tar xzf "$fetched" -C "$le"
    fi
    rm -f "$fetched"
  fi
  if ! openssl x509 -checkend $((30 * 86400)) -noout -in "$live/fullchain.pem" >/dev/null 2>&1; then
    certbot certonly --non-interactive --agree-tos -m "$CERT_EMAIL" --cert-name "$NAME" \
      --dns-cloudflare --dns-cloudflare-credentials "$run/secrets/certbot-cf.ini" --dns-cloudflare-propagation-seconds 30 \
      -d "$NAME" -d "*.$NAME"
    kept=$(mktemp)
    tar czf "$kept" -C "$le" .
    aws s3 cp "$kept" "s3://$BUCKET/tls/$NAME.tgz" >/dev/null
    rm -f "$kept"
  fi
}

runner_image() {
  local image=$lib/runner-all-rootfs.tar.gz
  if [ "$(cat "$lib/image.key" 2>/dev/null || true)" != "$IMAGE_KEY" ] || [ ! -s "$image" ]; then
    aws s3 cp "s3://$BUCKET/image/$IMAGE_KEY.tar.gz" "$image.part" >/dev/null
    mv "$image.part" "$image"
    printf '%s' "$IMAGE_KEY" > "$lib/image.key"
    own "$lib"
  fi
}

# A host whose organizations run their agents in containers has the runner image in Docker, tagged with its key, and no other runner
# image: a kept host would otherwise keep every image it was ever given.
container_image() {
  local archive=$lib/runner.docker.tar.gz stale
  if ! docker image inspect "gusto-runner:$IMAGE_KEY" >/dev/null 2>&1; then
    aws s3 cp "s3://$BUCKET/image/$IMAGE_KEY.docker.tar.gz" "$archive.part" >/dev/null
    docker load -q -i "$archive.part" >/dev/null
    rm -f "$archive.part"
    docker tag gusto-runner:latest "gusto-runner:$IMAGE_KEY"
  fi
  stale=$(docker images gusto-runner --format '{{.Tag}}' | grep -vx "$IMAGE_KEY" || true)
  for tag in $stale; do docker rmi "gusto-runner:$tag" >/dev/null; done
}

# The image an organization's agents run in: a container's, or the root file system an OpenShell sandbox is made from.
image() {
  case "${SANDBOX:-openshell}" in
  container) container_image ;;
  openshell) runner_image ;;
  *) echo "gusto-boot: SANDBOX is container or openshell, not $SANDBOX" >&2; exit 2 ;;
  esac
}

credentials() {
  rm -rf "$run/creds"
  READ_PARAMETER="gusto param" BEDROCK_PARAMETER=$MODEL_PARAMETER DEEPSEEK_PARAMETER=$DEEPSEEK_PARAMETER bash "${CREDENTIALS:-/usr/local/lib/gusto/credentials.sh}" "$run/creds"
  chmod 0700 "$run/creds"
  own "$run/creds"
}

# The lease starts with the first boot and is not written again by a later one, so
# starting this script again does not give a host more time.
lease() {
  local file=${GUSTO_LEASE_FILE:-$lib/lease.json} started
  if [ ! -e "$file" ]; then
    started=$(date +%s)
    mkdir -p "$(dirname "$file")"
    printf '{"deadline": %d, "hardMax": %d}\n' $((started + LEASE_MINUTES * 60)) $((started + MAX_HOURS * 3600)) > "$file"
    chmod 0644 "$file"
    [ -z "$owner" ] || chown "$owner:$owner" "$file"
  fi
}

# The secret is the one in Parameter Store, kept where the process that signs with it reads it and no one else does.
cell_secret() {
  (umask 077; param "$CELL_SECRET_PARAMETER" > "$run/cell-secret")
  own "$run/cell-secret"
}

# What the agent is called and where it is on the private network. The name is the instance's, so a host
# that is started again is another cell and the one it replaced is not mistaken for it.
cell_identity() {
  local id
  id=$(metadata instance-id)
  printf 'GUSTO_CELL_NAME=cell-%s\nGUSTO_CELL_PRIVATE=%s\n' "${id#i-}" "$(metadata local-ipv4)" > "$run/cell.env"
}

point_the_name_here() {
  local ip
  ip=$(metadata public-ipv4)
  gusto-dns -zone "$ZONE" -name "$NAME" -ip "$ip" -token-file "$run/secrets/cf-dns-token"
  echo "gusto-boot: $NAME and *.$NAME point at $ip"
}

install -d -m 0755 "$run" "$lib"
install -d -m 0700 "$run/secrets"
case "$role" in
all)
  tokens; turnstile; lead_hook; certificate; image; credentials; lease; point_the_name_here ;;
orchestrator)
  tokens; turnstile; lead_hook; cell_secret; certificate; [ "${LIVE:-off}" = on ] || lease; point_the_name_here ;;
cell)
  cell_secret; image; credentials; cell_identity
  echo "gusto-boot: this host is a host of gusto cloud" ;;
*)
  echo "gusto-boot: ROLE is all, orchestrator or cell, not $role" >&2; exit 2 ;;
esac
