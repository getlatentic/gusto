# The front door's settings.
GUSTO_CLOUD_ROOT={{ cloud_state }}/cloud
GUSTO_CLOUD_ADDR=127.0.0.1:8050
# The accounts and each organization's task index live on this host's own disk, because a write-ahead log does not belong on a shared file system.
GUSTO_DATABASE_URL=sqlite://{{ cloud_lib }}/cloud.db
GUSTO_CLOUD_INDEX_DIR={{ cloud_lib }}/index
GUSTO_CLOUD_URL=https://{{ cloud_domain }}
GUSTO_CLOUD_DOMAIN={{ cloud_domain }}
GUSTO_CLOUD_APPS_DOMAIN={{ cloud_apps_domain or cloud_domain }}
GUSTO_CLOUD_ORG_ENV=/etc/gusto/org.env
{% if cloud_demo_sandbox != public_sandbox %}
GUSTO_CLOUD_DEMO_ENV=/etc/gusto/org-cloud.env
{% endif %}
GUSTO_CLOUD_PORT_FROM=9100
GUSTO_CLOUD_TRUST_PROXY=1
GUSTO_CLOUD_FREE_MAIL={{ cloud_free_mail }}
GUSTO_CLOUD_MAIL={{ cloud_mail }}
{% if not cloud_live | bool %}
GUSTO_CLOUD_LEASE_FILE={{ cloud_lib }}/lease.json
GUSTO_CLOUD_LEASE_STEP_MINUTES={{ cloud_lease_minutes }}
{% endif %}
{% if cloud_role == 'orchestrator' %}
# Organizations are placed on cells, which register in the directory on the shared file system.
GUSTO_CLOUD_NODES_DIR={{ cloud_state }}/cells
GUSTO_CLOUD_NODE_SECRET_FILE=/run/gusto/cell-secret
GUSTO_CLOUD_NODE_GONE_MINUTES={{ cloud_cell_gone_minutes }}
{% endif %}
{% if cloud_demo_minutes | int > 0 %}
# A visitor starts a demo without signing up, and it is deleted when its time is up.
GUSTO_CLOUD_DEMO_MINUTES={{ cloud_demo_minutes }}
GUSTO_CLOUD_DEMO_MAX={{ cloud_demo_max }}
GUSTO_CLOUD_BOOK_URL={{ cloud_book_url }}
GUSTO_CLOUD_TURNSTILE_SITE={{ cloud_turnstile_site }}
GUSTO_CLOUD_DEMO_NOTIFY={{ cloud_demo_notify }}
GUSTO_CLOUD_DEMO_STAFF={{ cloud_demo_staff }}
{% endif %}
{% if cloud_live | bool %}
# Hosts for cells are started when organizations wait for room, and stopped when a cell has had nothing on it.
GUSTO_CLOUD_NODE_LAUNCH=ec2
GUSTO_CLOUD_NODE_TEMPLATE={{ cloud_cell_template }}
GUSTO_CLOUD_NODE_PROJECT={{ cloud_project }}
GUSTO_CLOUD_NODE_USERDATA={{ cloud_cell_userdata }}
GUSTO_CLOUD_NODE_SETTINGS=RELEASE={{ cloud_release }},BUCKET={{ cloud_bucket }},REGION={{ cloud_region }},LEASE_MINUTES={{ cloud_cell_lease_minutes }},MAX_HOURS={{ cloud_cell_max_hours }},ROLE=cell,RUN={{ cloud_run }},EFS={{ cloud_efs.split('.')[0] }},LIVE=off,KIT={{ cloud_cell_kit }},BAKE_KEY={{ cloud_bake_key }}
GUSTO_CLOUD_NODE_MAX={{ cloud_cell_max }}
GUSTO_CLOUD_NODE_IDLE_MINUTES={{ cloud_cell_idle_minutes }}
GUSTO_CLOUD_NODE_PREWARMS={{ cloud_cell_prewarms }}
GUSTO_CLOUD_NODE_KEEP={{ cloud_cell_keep }}
GUSTO_CLOUD_NODE_IMAGE_PARAMETER={{ cloud_cell_image_parameter }}
{% endif %}
