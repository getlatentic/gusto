# The front door's settings.
GUSTO_CLOUD_ROOT={{ cloud_state }}/cloud
GUSTO_CLOUD_ADDR=127.0.0.1:{{ cloud_listen_port }}
# The accounts and each organization's task index stay on this host, in Postgres or in SQLite files on its own disk: a write-ahead log does not belong on a shared file system.
GUSTO_DATABASE_URL={{ cloud_accounts_url if cloud_postgres | bool else 'sqlite://' + cloud_lib + '/cloud.db' }}
GUSTO_CLOUD_INDEX_DIR={{ cloud_lib }}/index
GUSTO_CLOUD_URL=https://{{ cloud_domain }}
GUSTO_CLOUD_DOMAIN={{ cloud_domain }}
GUSTO_CLOUD_APPS_DOMAIN={{ cloud_apps_domain or cloud_domain }}
GUSTO_CLOUD_ORG_ENV={{ cloud_etc }}/org.env
{% if cloud_demo_sandbox != public_sandbox %}
GUSTO_CLOUD_DEMO_ENV={{ cloud_etc }}/org-demo.env
{% endif %}
GUSTO_CLOUD_PORT_FROM={{ cloud_port_from }}
GUSTO_CLOUD_TRUST_PROXY=1
GUSTO_CLOUD_FREE_MAIL={{ cloud_free_mail }}
GUSTO_CLOUD_MAIL={{ cloud_mail }}
{% if not cloud_live | bool %}
GUSTO_CLOUD_LEASE_FILE={{ cloud_lib }}/lease.json
GUSTO_CLOUD_LEASE_STEP_MINUTES={{ cloud_lease_minutes }}
{% endif %}
{% if cloud_servers != 'on' %}
GUSTO_CLOUD_SERVERS={{ cloud_servers }}
{% endif %}
{% if cloud_role == 'orchestrator' %}
# Organizations are placed on cells, which register in the directory on the shared file system.
GUSTO_CLOUD_NODES_DIR={{ cloud_state }}/cells
GUSTO_CLOUD_NODE_SECRET_FILE={{ cloud_rundir }}/cell-secret
GUSTO_CLOUD_NODE_GONE_MINUTES={{ cloud_cell_gone_minutes }}
{% endif %}
{% if cloud_demo_minutes | int > 0 %}
# A visitor starts a demo without signing up, and it is deleted when its time is up.
GUSTO_CLOUD_DEMO_MINUTES={{ cloud_demo_minutes }}
GUSTO_CLOUD_BOOK_URL={{ cloud_book_url }}
GUSTO_CLOUD_TURNSTILE_SITE={{ cloud_turnstile_site }}
GUSTO_CLOUD_DEMO_NOTIFY={{ cloud_demo_notify }}
GUSTO_CLOUD_DEMO_STAFF={{ cloud_demo_staff }}
{% endif %}
