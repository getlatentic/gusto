# TLS for the name and every name under it, and for the shared apps' name when they have one, passed to the front door on this host.
{# Named for this gusto cloud, since a host may serve two and nginx refuses a variable made twice. #}
map $http_upgrade ${{ cloud_name | replace('-', '_') }}_connection_upgrade {
    default upgrade;
    ''      close;
}

{% if cloud_default_server | bool %}
# A name that is not ours gets no answer.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}
{% endif %}

{# What every name is served with: the media, and the front door on this host. #}
{% macro served() %}
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 50m;

    # Media are files, served here with ranges so a video seeks, and never by the front door.
    location /media/ {
        alias {{ cloud_media }}/;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Cache-Control "public, max-age=3600";
    }

    location / {
        proxy_pass http://127.0.0.1:{{ cloud_listen_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The address nginx saw, and not one the visitor wrote.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection ${{ cloud_name | replace('-', '_') }}_connection_upgrade;
        # Pages that stream a running job are held open, and a room's page holds a WebSocket at /live, which the upgrade headers above
        # pass and which the server pings every 30 seconds.
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
{% endmacro %}

{# The names on TLS with a certificate of this host's, and, with a tunnel, on the loopback for cloudflared. #}
{% macro front_door(names, certificate) %}
server {
    listen 443 ssl;
    server_name {{ names }};

    ssl_certificate     /etc/letsencrypt/live/{{ certificate }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ certificate }}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
{{ served() }}
}
{% if cloud_tunnel_port | int > 0 %}

# The same names from Cloudflare's tunnel, which cloudflared on this host passes here. Cloudflare says who the visitor is.
server {
    listen 127.0.0.1:{{ cloud_tunnel_port }};
    server_name {{ names }};
    set_real_ip_from 127.0.0.1;
    real_ip_header CF-Connecting-IP;
{{ served() }}
}
{% endif %}
{% endmacro %}

{{ front_door(cloud_domain ~ ' *.' ~ cloud_domain, cloud_domain) }}
{% if cloud_apps_domain %}
# Shared apps, on a name of their own with a certificate of its own.
{{ front_door('*.' ~ cloud_apps_domain, cloud_apps_domain) }}
{% endif %}
