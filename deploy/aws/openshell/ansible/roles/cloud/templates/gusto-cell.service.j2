[Unit]
Description=gusto node: starts and stops organizations' servers for gusto cloud
After={{ cloud_name }}-boot.service {{ cloud_sandboxes | map('extract', cloud_sandbox_unit) | select | join(' ') }}
Requires={{ cloud_name }}-boot.service
RequiresMountsFor={{ cloud_state }}

[Service]
User={{ cloud_user }}
SupplementaryGroups={{ cloud_sandboxes | map('extract', cloud_sandbox_group) | select | join(' ') }}
WorkingDirectory={{ cloud_lib }}
EnvironmentFile={{ cloud_etc }}/org.env
EnvironmentFile={{ cloud_etc }}/cell.env
EnvironmentFile={{ cloud_rundir }}/cell.env
# The first question asked of the image waits for the gateway to import it. It is asked here, so the cell registers,
# and is given organizations, once the servers it starts will not wait for that.
ExecStartPre={{ cloud_bin }}/gusto scan
{% if cloud_demo_sandbox != public_sandbox %}
# And of a demo's sandbox, whose settings are a file of plain KEY=VALUE lines.
ExecStartPre=/bin/sh -c 'set -a; . {{ cloud_etc }}/org-demo.env; exec {{ cloud_bin }}/gusto scan'
{% endif %}
TimeoutStartSec=900
ExecStart={{ cloud_bin }}/gusto node
Restart=on-failure
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
