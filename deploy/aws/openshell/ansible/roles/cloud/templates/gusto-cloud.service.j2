[Unit]
Description=gusto public cloud: gusto cloud and each organization's server
After=gusto-boot.service{{ (' ' + cloud_sandboxes | map('extract', cloud_sandbox_unit) | select | join(' ')) if cloud_role != 'orchestrator' else '' }}
Requires=gusto-boot.service
RequiresMountsFor={{ cloud_state }}

[Service]
User={{ cloud_user }}
# A front door alone runs no agents and has no Docker, so no docker group either. Rootless podman needs no group.
SupplementaryGroups={{ cloud_sandboxes | map('extract', cloud_sandbox_group) | select | join(' ') if cloud_role != 'orchestrator' else 'kvm' }}
WorkingDirectory={{ cloud_state }}
# The AWS command is a snap, which the default path does not have.
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/snap/bin
EnvironmentFile=/etc/gusto/cloud.env
EnvironmentFile=/run/gusto/secrets/mail.env
EnvironmentFile=-/run/gusto/secrets/turnstile.env
EnvironmentFile=-/run/gusto/secrets/leadhook.env
EnvironmentFile=-/run/gusto/secrets/google.env
EnvironmentFile=-/run/gusto/secrets/stripe.env
ExecStart=/usr/local/bin/gusto cloud
Restart={{ "always" if cloud_live | bool else "on-failure" }}
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
