[Unit]
Description=gusto public cloud: gusto cloud and each organization's server
After={{ cloud_name }}-boot.service{{ (' ' + cloud_sandboxes | map('extract', cloud_sandbox_unit) | select | join(' ')) if cloud_role != 'orchestrator' else '' }}
Requires={{ cloud_name }}-boot.service
RequiresMountsFor={{ cloud_state }}

[Service]
User={{ cloud_user }}
# A front door alone runs no agents and has no Docker, so no docker group either. Rootless podman needs no group.
SupplementaryGroups={{ cloud_sandboxes | map('extract', cloud_sandbox_group) | select | join(' ') if cloud_role != 'orchestrator' else 'kvm' }}
WorkingDirectory={{ cloud_state }}
# The AWS command is a snap, which the default path does not have.
Environment=PATH={{ cloud_bin }}:/usr/local/bin:/usr/bin:/bin:/snap/bin
EnvironmentFile={{ cloud_etc }}/cloud.env
EnvironmentFile={{ cloud_rundir }}/secrets/mail.env
EnvironmentFile=-{{ cloud_rundir }}/secrets/turnstile.env
EnvironmentFile=-{{ cloud_rundir }}/secrets/leadhook.env
EnvironmentFile=-{{ cloud_rundir }}/secrets/google.env
EnvironmentFile=-{{ cloud_rundir }}/secrets/stripe.env
ExecStart={{ cloud_bin }}/gusto cloud
Restart={{ "always" if cloud_live | bool else "on-failure" }}
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
