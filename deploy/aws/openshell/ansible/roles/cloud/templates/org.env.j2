# What every organization's server is started with (GUSTO_CLOUD_ORG_ENV): a sign-up's agents run in {{ public_sandbox }}.
{% from 'sandbox.env.j2' import sandbox_env with context %}
{{ sandbox_env(public_sandbox) }}GUSTO_CREDENTIALS={{ cloud_rundir }}/creds
GUSTO_MODELS={{ cloud_models }}
GUSTO_CHAT_DEFAULT={{ cloud_chat_default }}
GUSTO_PROXY_MAX_OUTPUT_TOKENS={{ cloud_max_output_tokens }}
GUSTO_PROXY_SILENCE_SECONDS={{ cloud_model_silence_seconds }}
GUSTO_SPEND_POLICY={{ cloud_etc }}/spend-policy.json
GUSTO_MATRIX={{ cloud_etc }}/measured.json
AWS_REGION={{ cloud_region }}
# The clients the operator registered with the apps that need one, such as GitHub. Until the parameter is stored, those apps stay off.
GUSTO_CONNECTOR_CLIENTS=ssm:{{ cloud_connector_clients_parameter }}
{% if cloud_postgres | bool %}
# Each organization's indexes are in a schema of its own in this database, which gusto cloud names for it.
GUSTO_DATABASE_URL={{ cloud_postgres_url }}
{% endif %}
