# Copy to cloud.env and fill in. Nothing here is a secret: the tokens are in Parameter Store.
# The name organizations are served under, and the Cloudflare zone it is in.
GUSTO_CLOUD_DOMAIN=gusto.getlatentic.com
GUSTO_CLOUD_ZONE=getlatentic.com
# The name shared apps are served under, as <org>--<app>.<name>, and its Cloudflare zone: a domain of their own, so an app's
# pages cannot set a cookie gusto's own pages are sent. The DNS token must be able to edit this zone too. Empty serves apps
# under GUSTO_CLOUD_DOMAIN.
GUSTO_CLOUD_APPS_DOMAIN=
GUSTO_CLOUD_APPS_ZONE=
# Cloudflare's account id, and the address mail is sent from. The sending domain must be
# onboarded to Cloudflare Email Sending first.
GUSTO_CLOUDFLARE_ACCOUNT_ID=
GUSTO_MAIL_FROM="gusto <no-reply@notification.getlatentic.com>"
# Where Let's Encrypt writes about the certificate.
GUSTO_CERT_EMAIL=
# Whether an address at a free mail provider, gmail for one, may sign up.
GUSTO_CLOUD_FREE_MAIL=allow
# The model the agents are offered, and how big each person's computer is.
GUSTO_MODELS=gemma/google.gemma-4-26b-a4b,gemma/google.gemma-4-31b,deepseek/deepseek-flash,meta/muse-spark-1.3
GUSTO_COMPUTER_MEMORY=3Gi
# GUSTO_CLOUD_DEMO_MINUTES=30   # a visitor may start a demo at /demo that lasts this long; unset offers none
# GUSTO_CLOUD_BOOK_URL=https://cal.com/you/gusto
# GUSTO_CLOUD_DEMO_NOTIFY=you@example.com   # mailed when a visitor starts a demo
# GUSTO_CLOUD_DEMO_STAFF=example.com         # only these addresses or domains may start a demo; visitors sign up instead
# GUSTO_CLOUD_TURNSTILE_SITE=0x4AAAA...   # the public site key of the Turnstile widget; its secret is stored by put-turnstile.sh
