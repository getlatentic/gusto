# Copy to demo.env and fill in. Nothing here is a secret: the tokens are in Parameter Store.
# The name organizations are served under, and the Cloudflare zone it is in.
DEMO_NAME=gusto.getlatentic.com
DEMO_ZONE=getlatentic.com
# The name shared apps are served under, as <org>--<app>.<name>, and its Cloudflare zone: a domain of their own, so an app's
# pages cannot set a cookie gusto's own pages are sent. The DNS token must be able to edit this zone too. Empty serves apps
# under DEMO_NAME.
DEMO_APPS_NAME=
DEMO_APPS_ZONE=
# Cloudflare's account id, and the address mail is sent from. The sending domain must be
# onboarded to Cloudflare Email Sending first.
DEMO_ACCOUNT_ID=
DEMO_MAIL_FROM="gusto <no-reply@notification.getlatentic.com>"
# Where Let's Encrypt writes about the certificate.
DEMO_CERT_EMAIL=
# Whether an address at a free mail provider, gmail for one, may sign up.
DEMO_FREE_MAIL=allow
# The model the agents are offered, and how big each person's computer is.
DEMO_MODELS=gemma/google.gemma-4-26b-a4b,gemma/google.gemma-4-31b,deepseek/deepseek-flash,meta/muse-spark-1.3
DEMO_COMPUTER_MEMORY=3Gi
# DEMO_VISITOR_MINUTES=30   # a visitor may start a demo at /demo that lasts this long; unset offers none
# DEMO_BOOK_URL=https://cal.com/you/gusto
# DEMO_NOTIFY=you@example.com   # mailed when a visitor starts a demo
# DEMO_STAFF=example.com         # only these addresses or domains may start a demo; visitors sign up instead
# DEMO_TURNSTILE_SITE=0x4AAAA...   # the public site key of the Turnstile widget; its secret is stored by put-turnstile.sh
