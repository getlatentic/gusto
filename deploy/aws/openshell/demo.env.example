# Copy to demo.env and fill in. Nothing here is a secret: the tokens are in Parameter Store.
# The name organisations are served under, and the Cloudflare zone it is in.
DEMO_NAME=agentcloud.getlatentic.com
DEMO_ZONE=getlatentic.com
# Cloudflare's account id, and the address mail is sent from. The sending domain must be
# onboarded to Cloudflare Email Sending first.
DEMO_ACCOUNT_ID=
DEMO_MAIL_FROM="haas <no-reply@notifications.agentcloud.getlatentic.com>"
# Where Let's Encrypt writes about the certificate.
DEMO_CERT_EMAIL=
# Whether an address at a free mail provider, gmail for one, may sign up.
DEMO_FREE_MAIL=allow
# The model the agents are offered, and how big each person's computer is.
DEMO_MODELS=platform/qwen.qwen3-vl-235b-a22b-instruct
DEMO_COMPUTER_MEMORY=3Gi
# DEMO_VISITOR_MINUTES=30   # a visitor may start a demo at /demo that lasts this long; unset offers none
# DEMO_BOOK_URL=https://cal.com/you/haas
# DEMO_VIDEO_URL=https://www.loom.com/embed/...   # the landing page shows it; a .mp4 or .webm file works too
# DEMO_TURNSTILE_SITE=0x4AAAA...   # the public site key of the Turnstile widget; its secret is stored by put-turnstile.sh
