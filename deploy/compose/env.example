# Copy to .env beside compose.yaml. Compose reads it twice: for the values in
# compose.yaml, and as the server's environment. The README's Environment table
# says what every HAAS_ setting does.

# ── The install ─────────────────────────────────────────────────────────────
# Where jobs and conversations live on the host. It is mounted at the same path
# inside the server, because the runtime resolves the paths the server names on
# the host.
HAAS_DATA=/var/lib/haas
# The host's container runtime. Rootful Docker is /var/run/docker.sock. For
# rootful podman, run `systemctl enable --now podman.socket` and use
# /run/podman/podman.sock. deploy/README.md says what holding it is worth.
HAAS_RUNTIME_SOCKET=/var/run/docker.sock
# Where the pages and the API are published on the host. Loopback, so a proxy
# that terminates TLS goes in front before anybody signs in from elsewhere.
HAAS_PUBLISH=127.0.0.1:8040
# The harnesses the runner image carries, as name=package, space separated.
HAAS_RUNNER_HARNESSES=opencode=opencode-ai
# The npm packages of the MCP servers the runner carries, space separated. A
# sealed job fetches nothing, so a server a setup names has to be in the image.
HAAS_RUNNER_MCP=

# ── Sign-in ─────────────────────────────────────────────────────────────────
# Required. The server will not start without it.
HAAS_PASSWORD=

# Set this and the API takes scoped, revocable tokens an admin makes at /tokens
# instead of the shared password. docs/TOKENS.md.
# HAAS_API_TOKENS=/var/lib/haas/tokens/tokens.json

# ── The model ───────────────────────────────────────────────────────────────
# With an upstream the proxy is on: a job's container gets no network but the
# proxy's socket, and the key below never enters it. The upstream is the
# model's root address, with no version on the end.
HAAS_MODEL_UPSTREAM=
HAAS_MODEL_KEY=
HAAS_MODEL_NAME=the platform credential
# What the pages offer to think with, comma separated.
HAAS_MODELS=
# Hosts besides the model a job may reach, comma separated. Nothing is nothing.
HAAS_ALLOWED_HOSTS=

# ── What one job may take ───────────────────────────────────────────────────
HAAS_JOB_CONCURRENCY=1
HAAS_JOB_MEMORY=3g
HAAS_JOB_CPUS=1
