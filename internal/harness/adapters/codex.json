{
  "name": "codex",
  "what": "OpenAI's coding agent, run once per task rather than held open.",
  "program": "codex",
  "argv": [
    "exec",
    "--json",
    "--skip-git-repo-check",
    "-s",
    "workspace-write",
    "-c",
    "model_providers.haas.name=haas",
    "-c",
    "model_providers.haas.base_url={modelUrl}",
    "-c",
    "model_providers.haas.env_key=HAAS_MODEL_TOKEN",
    "-c",
    "model_providers.haas.wire_api=responses",
    "-c",
    "model_provider=haas",
    "--model={modelId}"
  ],
  "stdin": "{brief}",
  "needs": "key",
  "stream": "jsonl",
  "totals": "perCall",
  "text": "item.text",
  "toolName": "item.command",
  "toolStatus": "item.status",
  "sessionId": "thread_id",
  "inputTokens": "usage.input_tokens",
  "outputTokens": "usage.output_tokens",
  "cacheReadTokens": "usage.cached_input_tokens",
  "cacheWriteTokens": "usage.cache_write_input_tokens",
  "endpoint": "https://api.openai.com"
}
