{
  "name": "codex",
  "title": "Codex",
  "what": "OpenAI's coding agent, run once per task rather than held open.",
  "program": "codex",
  "package": "@openai/codex@0.154.0",
  "argv": [
    "exec",
    "--json",
    "--skip-git-repo-check",
    "-s",
    "workspace-write",
    "-c",
    "model_providers.gusto.name=gusto",
    "-c",
    "model_providers.gusto.base_url={modelUrl}",
    "-c",
    "model_providers.gusto.env_key=GUSTO_MODEL_TOKEN",
    "-c",
    "model_providers.gusto.wire_api=responses",
    "-c",
    "model_provider=gusto",
    "--model={modelId}"
  ],
  "resume": [
    "exec",
    "-s",
    "workspace-write",
    "resume",
    "--json",
    "--skip-git-repo-check",
    "-c",
    "model_providers.gusto.name=gusto",
    "-c",
    "model_providers.gusto.base_url={modelUrl}",
    "-c",
    "model_providers.gusto.env_key=GUSTO_MODEL_TOKEN",
    "-c",
    "model_providers.gusto.wire_api=responses",
    "-c",
    "model_provider=gusto",
    "-m",
    "{modelId}",
    "{session}",
    "-"
  ],
  "stdin": "{brief}",
  "needs": "key",
  "speaks": "responses",
  "skills": "/root/.local/share/codex/skills",
  "keeps": "/root/.local/share/codex",
  "whenBoxed": {
    "workspace-write": "danger-full-access"
  },
  "mcp": {
    "format": "codex",
    "argv": [
      "-c",
      "{mcp}"
    ]
  },
  "stream": "jsonl",
  "when": {
    "text": {
      "item.type": "agent_message"
    }
  },
  "totals": "perCall",
  "text": "item.text",
  "message": "item.id",
  "toolName": "item.command",
  "toolStatus": "item.status",
  "sessionId": "thread_id",
  "inputTokens": "usage.input_tokens",
  "outputTokens": "usage.output_tokens",
  "cacheReadTokens": "usage.cached_input_tokens",
  "cacheWriteTokens": "usage.cache_write_input_tokens",
  "endpoint": "https://api.openai.com",
  "env": {
    "CODEX_HOME": "/root/.local/share/codex"
  }
}
