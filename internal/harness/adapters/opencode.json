{
  "name": "opencode",
  "program": "opencode",
  "argv": [
    "run",
    "--format",
    "json",
    "--model={model}",
    "{brief}"
  ],
  "resume": [
    "run",
    "--format",
    "json",
    "--session={session}",
    "--model={model}",
    "{brief}"
  ],
  "needs": "local",
  "stream": "jsonl",
  "totals": "perCall",
  "text": "part.text",
  "sessionId": "sessionID",
  "toolName": "part.tool",
  "toolInput": "part.state.input",
  "toolStatus": "part.state.status",
  "toolTitle": "part.state.title",
  "inputTokens": "part.tokens.input",
  "outputTokens": "part.tokens.output",
  "costUsd": "part.cost"
}
