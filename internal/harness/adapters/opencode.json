{
  "name": "opencode",
  "what": "Open source, and points at whichever model the deployment gives it.",
  "program": "opencode",
  "argv": [
    "run",
    "--format",
    "json",
    "--model={model}",
    "{brief}"
  ],
  "resume": [
    "run",
    "--format",
    "json",
    "--session={session}",
    "--model={model}",
    "{brief}"
  ],
  "needs": "local",
  "skills": "/root/.config/opencode/skills",
  "mcp": {
    "format": "opencode",
    "env": {
      "OPENCODE_CONFIG_CONTENT": "{mcp}"
    }
  },
  "stream": "jsonl",
  "totals": "perCall",
  "text": "part.text",
  "sessionId": "sessionID",
  "toolName": "part.tool",
  "toolInput": "part.state.input",
  "toolStatus": "part.state.status",
  "toolTitle": "part.state.title",
  "inputTokens": "part.tokens.input",
  "outputTokens": "part.tokens.output",
  "costUsd": "part.cost"
}
