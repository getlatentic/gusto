{
  "name": "hermes",
  "title": "Hermes",
  "what": "Nous Research's agent, which remembers what it learns across sessions.",
  "program": "sh",
  "package": "hermes-agent@0.21.5",
  "argv": [
    "-c",
    "mkdir -p \"$HERMES_HOME\" && cp /root/.config/hermes/config.yaml \"$HERMES_HOME/config.yaml\" && exec hermes acp --accept-hooks"
  ],
  "env": {
    "HERMES_HOME": "/root/.local/share/hermes",
    "HAAS_MODEL_ID": "{modelId}"
  },
  "needs": "key",
  "skills": "/root/.agents/skills",
  "mcp": {
    "format": "acp"
  },
  "stream": "acp",
  "toolName": "params.update.kind",
  "toolTitle": "params.update.title"
}
