{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "haas-{env:HAAS_MODEL_PROVIDER}": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "{env:HAAS_MODEL_PROVIDER}",
      "options": {
        "baseURL": "{env:HAAS_MODEL_URL}",
        "apiKey": "{env:HAAS_MODEL_TOKEN}"
      },
      "models": {
        "{env:HAAS_MODEL_ID}": {
          "name": "{env:HAAS_MODEL_ID}"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://host.docker.internal:11434/v1"
      },
      "models": {
        "llama3.2:3b": {
          "name": "Llama 3.2 3B"
        },
        "gpt-oss:20b": {
          "name": "GPT-OSS 20B"
        }
      }
    }
  },
  "disabled_providers": [
    "haas"
  ],
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "webfetch": "deny"
  }
}
