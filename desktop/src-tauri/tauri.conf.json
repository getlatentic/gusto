{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gusto",
  "version": "0.1.0",
  "identifier": "com.latentic.gusto.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/gusto-helper",
      "binaries/gusto"
    ],
    "category": "DeveloperTool",
    "shortDescription": "gusto",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "latentic"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERENzAzRDY2NjIyQTRFQUMKUldTc1RpcGlaajF3M1pUK2ZjWUJEWEoxK1p2Q3BMc0I4YmFobGxNVU9UaW1Tbmp1NjNRWnc5ZkEK"
    }
  }
}
