{
  "name": "opencode",
  "title": "OpenCode",
  "what": "Open source, and points at whichever model the deployment gives it.",
  "program": "opencode",
  "package": "opencode-ai",
  "env": {
    "GUSTO_MODEL_PROVIDER": "{modelProvider}",
    "GUSTO_MODEL_ID": "{modelId}"
  },
  "argv": [
    "acp"
  ],
  "needs": "local",
  "skills": "/root/.config/opencode/skills",
  "mcp": {
    "format": "acp"
  },
  "stream": "acp"
}
