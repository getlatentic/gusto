{
  "name": "codex",
  "title": "Codex",
  "what": "OpenAI's coding agent, run once per task rather than held open.",
  "program": "codex-acp",
  "package": "@agentclientprotocol/codex-acp",
  "argv": [],
  "env": {
    "CODEX_HOME": "/root/.local/share/codex",
    "OPENAI_API_KEY": "{modelToken}",
    "GUSTO_MODEL_TOKEN": "{modelToken}",
    "CODEX_CONFIG": "{\"model\": \"{modelId}\", \"model_provider\": \"gusto\", \"model_providers\": {\"gusto\": {\"name\": \"gusto\", \"base_url\": \"{modelUrl}\", \"env_key\": \"GUSTO_MODEL_TOKEN\", \"wire_api\": \"responses\"}}}",
    "INITIAL_AGENT_MODE": "workspace-write",
    "NO_BROWSER": "1"
  },
  "whenBoxed": {
    "workspace-write": "agent-full-access"
  },
  "authenticate": "api-key",
  "needs": "key",
  "speaks": "responses",
  "skills": "/root/.local/share/codex/skills",
  "keeps": "/root/.local/share/codex",
  "mcp": {
    "format": "acp"
  },
  "stream": "acp",
  "endpoint": "https://api.openai.com"
}
